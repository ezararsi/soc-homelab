# Vorlage: kopieren nach .env und Werte eintragen. Die .env wird NICHT committet.
#
# Der Indexer lauscht im Lab nur lokal auf WAZUH01 -> Zugriff per SSH-Tunnel:
#   ssh -L 9200:127.0.0.1:9200 socadmin@10.10.20.10
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# true = Zertifikat prüfen, false = nicht prüfen (nur Lab, selbstsigniert),
# oder Pfad zum CA-Zertifikat von WAZUH01 (empfohlen), z. B. ./root-ca.pem
WAZUH_VERIFY_TLS=./root-ca.pem

# Optional
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_TIMEOUT=30
